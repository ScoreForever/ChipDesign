+module npu_tensor_lookup #(parameter MAX_OPS=128) (
+    input wire clk,rst,seed,start,save,
+    input wire [7:0] pc,
+    input wire input_i32,src_i32,dst_i32,add_op,
+    input wire [15:0] input_first,input_end,src,src_end,src2,src2_end,dst,dst_end,
